{{!-- Scripts and styles for markdown doc pages (included from markdown.hbs). --}}
<link rel="stylesheet" href="/css/markdown.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js" crossorigin="anonymous"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/languages/yaml.min.js" crossorigin="anonymous"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/languages/markdown.min.js" crossorigin="anonymous"></script>
<script src="https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.min.js"></script>
<script>
(function () {
  function mermaidSchemeIsDark() {
    var root = document.documentElement;
    var scheme = root.getAttribute('data-color-scheme');
    if (scheme === 'dark') return true;
    if (scheme === 'light') return false;
    return window.matchMedia('(prefers-color-scheme: dark)').matches;
  }

  function mermaidCardIsInverted(card) {
    var forced = card.getAttribute('data-mermaid-invert');
    if (forced === 'on') return true;
    if (forced === 'off') return false;
    return mermaidSchemeIsDark();
  }

  function syncMermaidInvertButton(card) {
    var btn = card.querySelector('[data-mermaid-invert-toggle]');
    if (!btn) return;
    var on = mermaidCardIsInverted(card);
    btn.setAttribute('aria-pressed', on ? 'true' : 'false');
    btn.classList.toggle('code-card__invert--active', on);
  }

  document.querySelectorAll('.code-card--mermaid').forEach(function (card) {
    var tabs = card.querySelectorAll('.code-card__tabs .code-card__tab');
    var panels = card.querySelectorAll('.code-card__panel');
    tabs.forEach(function (tab) {
      tab.addEventListener('click', function () {
        var tabName = tab.getAttribute('data-tab');
        tabs.forEach(function (t) {
          t.classList.toggle('code-card__tab--active', t === tab);
          t.setAttribute('aria-selected', t === tab ? 'true' : 'false');
        });
        panels.forEach(function (panel) {
          var show = panel.getAttribute('data-tab') === tabName;
          panel.classList.toggle('code-card__panel--active', show);
          panel.hidden = !show;
        });
      });
    });

    var invertBtn = card.querySelector('[data-mermaid-invert-toggle]');
    if (invertBtn) {
      invertBtn.addEventListener('click', function () {
        card.setAttribute('data-mermaid-invert', mermaidCardIsInverted(card) ? 'off' : 'on');
        syncMermaidInvertButton(card);
      });
    }
    syncMermaidInvertButton(card);
  });

  new MutationObserver(function () {
    document.querySelectorAll('.code-card--mermaid').forEach(syncMermaidInvertButton);
  }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-color-scheme', 'data-theme'] });

  function highlightOnTabShow(tabId, selector) {
    var tab = document.getElementById(tabId);
    if (!tab) return;
    tab.addEventListener('shown.bs.tab', function () {
      var code = document.querySelector(selector);
      if (code && window.hljs && !code.dataset.hljsDone) {
        hljs.highlightElement(code);
        code.dataset.hljsDone = '1';
      }
    });
  }

  highlightOnTabShow('mdtab-front-matter-tab', '#markdown-frontmatter-source');
  highlightOnTabShow('mdtab-body-tab', '#markdown-body-source');
  highlightOnTabShow('mdtab-raw-tab', '#markdown-raw-source');

  if (typeof mermaid !== 'undefined') {
    mermaid.initialize({ startOnLoad: true, theme: 'neutral' });
  }
})();
</script>
