{{!-- Development folder listing: RequestHandler.showFolderIndex + docsIndex (/docs).
     Theme follows html data-theme / data-color-scheme (nav palette); no local dark-mode island. --}}
<link rel="stylesheet" href="/css/markdown.css">
<div class="folder-index" id="folder-index-root">
  <div class="folder-index__header">
    <h1 class="folder-index__title">Index of {{pathname}}</h1>
  </div>
  <nav class="folder-index__breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a>{{#if pathname}}{{#if parentPath}} / <a href="/{{parentPath}}/">{{parentPath}}</a>{{/if}} / <span>{{title}}</span>{{/if}}
  </nav>
  <table class="folder-index__table">
    <thead>
      <tr>
        <th>Name</th>
        <th>Type</th>
      </tr>
    </thead>
    <tbody>
      {{#each entries}}
      <tr>
        <td>
          {{#if isDirectory}}
          <a href="{{../basePath}}{{name}}/">📁 {{name}}/</a>
          {{else}}
          <a href="{{../basePath}}{{name}}">{{name}}</a>
          {{/if}}
        </td>
        <td>{{#if isDirectory}}Directory{{else}}File{{/if}}</td>
      </tr>
      {{/each}}
    </tbody>
  </table>
</div>
