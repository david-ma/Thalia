{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["bun"]
  },
  "include": [
    "server/**/*",
    "models/**/*",
    "tests/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "websites/**/*"
  ]
}
