{{!--
  example-src: default to Agency pack so the landing matches Start Bootstrap Agency
  (static reference: websites/example-agency). Still respects an explicit thalia-theme choice.
--}}
<script>
(function () {
  var KNOWN = {
    light: 1, dark: 1, thalia: 1, "thalia-dark": 1,
    "solarized-light": 1, "solarized-dark": 1,
    "rose-pine": 1, "rose-pine-moon": 1, "rose-pine-dawn": 1,
    dracula: 1, monokai: 1, agency: 1
  };
  var DARK = {
    dark: 1, "thalia-dark": 1, "solarized-dark": 1,
    "rose-pine": 1, "rose-pine-moon": 1, dracula: 1, monokai: 1
  };
  try {
    var m = localStorage.getItem("thalia-theme");
    if (!m || !KNOWN[m]) {
      m = "agency";
      localStorage.setItem("thalia-theme", m);
    }
    if (m === "system") {
      document.documentElement.removeAttribute("data-theme");
      document.documentElement.setAttribute(
        "data-color-scheme",
        window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light"
      );
    } else if (KNOWN[m]) {
      document.documentElement.setAttribute("data-theme", m);
      document.documentElement.setAttribute(
        "data-color-scheme",
        DARK[m] ? "dark" : "light"
      );
    }
  } catch (e) {
    document.documentElement.setAttribute("data-theme", "agency");
    document.documentElement.setAttribute("data-color-scheme", "light");
  }
})();
</script>
